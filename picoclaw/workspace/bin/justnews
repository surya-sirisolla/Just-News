#!/bin/sh
# Entry point PicoClaw's exec tool calls. It lives inside the PicoClaw workspace so
# it passes the workspace sandbox, then runs the Python agents from the project root.
ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$ROOT" || exit 1
PY="${JUSTNEWS_PYTHON:-$ROOT/.venv/bin/python}"
[ -x "$PY" ] || PY="$(command -v python3)"
exec "$PY" -m justnews "$@"
