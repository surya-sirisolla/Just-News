[Unit]
Description=Just News (WhatsApp bridge + hourly news cycle + Instagram publishing)
After=network-online.target
Wants=network-online.target

[Service]
User=justnews
WorkingDirectory=/opt/justnews
ExecStart=/opt/justnews/.venv/bin/python -m justnews serve
Restart=always
RestartSec=15
# If the kernel kills a child for memory (the video encoder), keep the bot running: the recap fails
# on its own and says so, instead of WhatsApp and the hourly cycle going down with it.
OOMPolicy=continue
# Secrets come from /opt/justnews/.env (mode 600, never in git). On EC2 the S3 access comes
# from the instance's IAM role, so .env needs no AWS keys there.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
