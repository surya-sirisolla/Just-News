# --- Evaluator backend ----------------------------------------------------------
# LLM_PROVIDER: jev (default when TYPESAFE_API_KEY is set), claude, or gemini
# LLM_PROVIDER=jev
TYPESAFE_API_KEY=
# Claude also powers PicoClaw's orchestrator (PICOCLAW_LLM_PROVIDER=claude|gemini, default claude)
CLAUDE_API_KEY=

# Optional overrides (defaults: jev-1.14.0 at $0.042/$0, claude-haiku-5-5 at $0.10/$0.50,
# gemini-3.1-flash-lite at $0.25/$1.50)
# LLM_MODEL=claude-haiku-5-5
# LLM_PRICE_INPUT_PER_M=0.10      # USD per 1M tokens, used only for the cost estimate
# LLM_PRICE_OUTPUT_PER_M=0.50
# JUSTNEWS_CLAUDE_EFFORT=low       # low | medium | high
# GEMINI_THINKING_LEVEL=minimal
# JUSTNEWS_ANTHROPIC_BASE_URL=https://api.anthropic.com

# Model PicoClaw's orchestrator uses for its own tool-calling turns
# PICOCLAW_MODEL=claude-haiku-5-5

# --- Content creator (Gemini free tier) ------------------------------------------
# Key from a Google AI Studio project with NO billing attached (free tier; prompts may be used by Google).
GEMINI_API_KEY=
# Tried in order; the next is used on timeouts, overload (503), or an exhausted daily quota.
# GEMINI_CONTENT_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_MIN_INTERVAL_SECONDS=6       # spacing between requests (free-tier requests-per-minute)
# GEMINI_CONTENT_TIME_BUDGET=150      # seconds; posts left pending after this
# JUSTNEWS_MAX_POSTS_PER_RUN=10

# --- Image designer ---------------------------------------------------------------
# JUSTNEWS_IMAGE_SIZE=1080x1080
# JUSTNEWS_IMAGE_LICENSES=cc0,pd,cc-by,cc-by-sa   # NC and ND are never allowed
# JUSTNEWS_PHOTO_SEARCH=true
# JUSTNEWS_CONTACT=you@example.com    # sent to Wikimedia in the User-Agent, as its API policy asks
# JUSTNEWS_BRAND=JUST NEWS
# JUSTNEWS_OUTPUT_DIR=output

# --- WhatsApp approval (linked spare number, no Meta account) --------------------
# Your own WhatsApp number: the bot messages it and accepts approvals only from it.
# Digits with country code, no "+", e.g. 919812345678. Approval is off while this is empty.
# WHATSAPP_OWNER_NUMBER=
# WHATSAPP_SESSION_PATH=data/whatsapp-session.sqlite3   # the linked session; keep it private
# JUSTNEWS_APPROVAL_EXPIRY_HOURS=12
# GEMINI_CHAT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash  # bot conversation

# --- Discovery ----------------------------------------------------------------
JUSTNEWS_CATEGORIES=Technology,AI,Business,Politics,World
JUSTNEWS_MAX_AGE_HOURS=36
JUSTNEWS_MAX_PER_CATEGORY=12
JUSTNEWS_REQUEST_TIMEOUT=15
JUSTNEWS_REQUEST_RETRIES=2

# --- Evaluation ---------------------------------------------------------------
JUSTNEWS_EVAL_BATCH_SIZE=20
JUSTNEWS_RECOMMEND_THRESHOLD=70
JUSTNEWS_HISTORY_DAYS=7

# --- Paths and logging --------------------------------------------------------
# JUSTNEWS_DB_PATH=data/justnews.db
# JUSTNEWS_LOG_DIR=logs
JUSTNEWS_LOG_LEVEL=INFO
