# --- Evaluator backend ----------------------------------------------------------
# LLM_PROVIDER: jev (default when TYPESAFE_API_KEY is set), claude, or gemini
# LLM_PROVIDER=jev
TYPESAFE_API_KEY=
# Claude also powers PicoClaw's orchestrator (PICOCLAW_LLM_PROVIDER=claude|gemini, default claude)
CLAUDE_API_KEY=

# Optional overrides (defaults: jev-1.14.0 at $0.042/$0, claude-haiku-5-5 at $0.10/$0.50,
# gemini-3.1-flash-lite at $0.25/$1.50)
# LLM_MODEL=claude-haiku-5-5
# LLM_PRICE_INPUT_PER_M=0.10      # USD per 1M tokens, used only for the cost estimate
# LLM_PRICE_OUTPUT_PER_M=0.50
# JUSTNEWS_CLAUDE_EFFORT=low       # low | medium | high
# GEMINI_THINKING_LEVEL=minimal
# JUSTNEWS_ANTHROPIC_BASE_URL=https://api.anthropic.com

# Model PicoClaw's orchestrator uses for its own tool-calling turns
# PICOCLAW_MODEL=claude-haiku-5-5

# --- Content creator (Gemini free tier) ------------------------------------------
# Key from a Google AI Studio project with NO billing attached (free tier; prompts may be used by Google).
GEMINI_API_KEY=
# Tried in order; the next is used on timeouts, overload (503), or an exhausted daily quota.
# GEMINI_CONTENT_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_MIN_INTERVAL_SECONDS=6       # spacing between requests (free-tier requests-per-minute)
# GEMINI_CONTENT_TIME_BUDGET=150      # seconds; posts left pending after this
# JUSTNEWS_MAX_POSTS_PER_RUN=10

# --- Image designer ---------------------------------------------------------------
# JUSTNEWS_IMAGE_SIZE=1080x1080
# JUSTNEWS_IMAGE_LICENSES=cc0,pd,cc-by,cc-by-sa   # NC and ND are never allowed
# JUSTNEWS_PHOTO_SEARCH=true
# JUSTNEWS_CONTACT=you@example.com    # sent to Wikimedia in the User-Agent, as its API policy asks
# JUSTNEWS_BRAND=JUST NEWS
# JUSTNEWS_OUTPUT_DIR=output

# --- WhatsApp approval (linked spare number, no Meta account) --------------------
# Your own WhatsApp number: the bot messages it and accepts approvals only from it.
# Digits with country code, no "+", e.g. 919812345678. Approval is off while this is empty.
# WHATSAPP_OWNER_NUMBER=
# WHATSAPP_SESSION_PATH=data/whatsapp-session.sqlite3   # the linked session; keep it private
# JUSTNEWS_APPROVAL_EXPIRY_HOURS=1
# JUSTNEWS_CYCLE_MINUTES=60        # `serve` runs a news cycle this often
# JUSTNEWS_TIMEZONE=Asia/Kolkata     # times shown in WhatsApp messages
# GEMINI_CHAT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash  # bot conversation

# --- Instagram publishing (after WhatsApp approval) -------------------------------
# Meta system-user token (Business Settings > System users > Generate token) with
# instagram_basic + instagram_content_publish, and the account's numeric ID.
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=
# Private S3 bucket: Instagram gets a 1-hour presigned link to each JPEG.
# On AWS, use an IAM role instead of the two keys.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# JUSTNEWS_S3_BUCKET=
# JUSTNEWS_MAX_POSTS_PER_DAY=20        # per platform; an Instagram carousel counts as one
# JUSTNEWS_INSTAGRAM_CAROUSEL=true     # stories approved together -> one swipeable carousel

# --- X publishing (after WhatsApp approval) -----------------------------------------
# console.x.com app with Read and write permissions; OAuth 1.0a keys for the posting account.
# Posting needs Pay-Per-Use credits (about $0.015 per post; the publisher never adds links).
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
# JUSTNEWS_X_SPACING_MINUTES=5         # one X post per story, this far apart
# JUSTNEWS_X_QUEUE_MAX_HOURS=3         # queued posts older than this are dropped, not posted stale
# JUSTNEWS_RECAP_TIME=21:30             # daily recap Reel of the day's posts ("off" disables)
# JUSTNEWS_RECAP_MAX_STORIES=5

# --- Engagement strategist (Agent 6) ------------------------------------------------
# JUSTNEWS_STRATEGIST=false   # true turns Agent 6 on
# JUSTNEWS_BENCHMARK_INSTAGRAM=bbcnews,reuters,ndtv,cnn   # needs instagram_manage_insights + pages_read_engagement
# JUSTNEWS_BENCHMARK_X=BBCWorld,Reuters,ndtv              # $0.005 per post read
# JUSTNEWS_BENCHMARK_POSTS=10
# JUSTNEWS_BENCHMARK_EVERY_HOURS=72

# --- Discovery ----------------------------------------------------------------
JUSTNEWS_CATEGORIES=India,South India,Business,Technology,AI,World
# JUSTNEWS_INTERNATIONAL_SHARE=0.2       # world news: at most this share of a shortlist...
# JUSTNEWS_INTERNATIONAL_MIN_SCORE=85    # ...and only when this important
# JUSTNEWS_SOUTH_INDIA_SHARE=0.4         # share of the list kept for South Indian stories
# JUSTNEWS_RESEARCH_THRESHOLD=55         # "research on ..." from WhatsApp: lower bar, best 5
# JUSTNEWS_RESEARCH_MAX_POSTS=5
JUSTNEWS_MAX_AGE_HOURS=36
JUSTNEWS_MAX_PER_CATEGORY=12
JUSTNEWS_REQUEST_TIMEOUT=15
JUSTNEWS_REQUEST_RETRIES=2

# --- Evaluation ---------------------------------------------------------------
JUSTNEWS_EVAL_BATCH_SIZE=20
JUSTNEWS_RECOMMEND_THRESHOLD=70
JUSTNEWS_HISTORY_DAYS=7

# --- Paths and logging --------------------------------------------------------
# JUSTNEWS_DB_PATH=data/justnews.db
# JUSTNEWS_LOG_DIR=logs
JUSTNEWS_LOG_LEVEL=INFO
